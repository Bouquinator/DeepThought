#!/bin/sh
# DeepThought launcher: finds a Python >= 3.10 and runs the tester.
# No installation needed: clone the repo and run ./dt
DT_ROOT="$(cd "$(dirname "$0")" && pwd -P)"
for py in "$DT_PYTHON" python3 python3.14 python3.13 python3.12 python3.11 python3.10 python; do
	[ -z "$py" ] && continue
	command -v "$py" >/dev/null 2>&1 || continue
	if "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
		exec "$py" "$DT_ROOT/deepthought/__main__.py" "$@"
	fi
done
echo "DeepThought needs Python 3.10 or newer (set DT_PYTHON=/path/to/python3)." >&2
exit 1
